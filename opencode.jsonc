{
  "$schema": "https://opencode.ai/config.json",
  // Agente principal por defecto para este proyecto.
  // "orchestrator" coordina el flujo: analyst → planner → builder → tester
  "default_agent": "orchestrator",
  // Formatear archivos automáticamente después de editar/escribir
  "formatter": true,
  // Compresión automática de contexto
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  // MCP servers disponibles
  "mcp": {
    "servers": {
      "mercadopago": {
        "type": "remote",
        "url": "https://mcp.mercadopago.com/mcp"
      }
    }
  },
  // Reglas generales de permisos
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npm run migrate*",
      "effect": "ask"
    }
  ]
}
