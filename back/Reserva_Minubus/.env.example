# Base de datos (Supabase / PostgreSQL)
DATABASE_URL=postgres://usuario:password@host.supabase.co:6543/postgres

# Mercado Pago
# Obtené tu Access Token desde: https://www.mercadopago.com.ar/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Seguridad
# Origenes CORS permitidos (separados por coma) - '*' para desarrollo
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Puerto del servidor
PORT=3000

# JWT Secret (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=tu-secret-aqui
