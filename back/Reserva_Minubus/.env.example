# Base de datos (Supabase / PostgreSQL)
DATABASE_URL=postgres://usuario:password@host.supabase.co:6543/postgres

# Mercado Pago (Single / Master Account)
# Obtené tu Access Token desde: https://www.mercadopago.com.ar/developers/panel
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Mercado Pago Marketplace (Multi-empresa / Split automático de comisiones)
# Credenciales de tu Aplicación Marketplace en MP Developers
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/pagos/oauth/callback
DEFAULT_PLATFORM_COMMISSION_PERCENT=10.0

# Frontend y URLs
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Email (SMTP / Gmail App Password)
# EMAIL_USER=vyvreservas25@gmail.com
# EMAIL_PASS=tu-app-password-de-gmail
# EMAIL_FROM_NAME=V&V Reservas 🚌
# EMAIL_FROM_ADDRESS=vyvreservas25@gmail.com

# Seguridad
# Origenes CORS permitidos (separados por coma) - '*' para desarrollo
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SESSION_COOKIE_SAME_SITE=lax
# En producción, si frontend y API están en sitios distintos, usar SameSite=None.
# SameSite=None requiere Secure (se activa automáticamente en producción).
SESSION_COOKIE_SECURE=false

# Puerto del servidor
PORT=3000

# JWT Secret (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=tu-secret-aqui
